generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Brand {
  id        String   @id @default(uuid())
  name      String
  country   String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cars Car[]
}

model Car {
  id           String   @id @default(uuid())
  name         String
  year         Int
  category     String
  imageUrl     String?
  videoUrl     String?
  history      String
  averagePrice Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  brandId String
  brand   Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  specs Specs?
}

model Specs {
  id           String   @id @default(uuid())
  engine       String
  horsepower   Int
  torque       String?
  transmission String?
  drivetrain   String?
  acceleration String?
  topSpeed     String?
  consumption  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  carId String @unique
  car   Car   @relation(fields: [carId], references: [id], onDelete: Cascade)
}